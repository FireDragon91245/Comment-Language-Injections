{
  "scopeName": "comment-language-injection.block",
  "injectionSelector": "L:comment.block",
  "patterns": [
    {
      "include": "#block-markdown"
    },
    {
      "include": "#block-json"
    },
    {
      "include": "#block-xml"
    },
    {
      "include": "#block-html"
    },
    {
      "include": "#block-css"
    },
    {
      "include": "#block-js"
    },
    {
      "include": "#block-py"
    },
    {
      "include": "#block-c"
    },
    {
      "include": "#block-cpp"
    },
    {
      "include": "#block-cmd"
    },
    {
      "include": "#block-bash"
    },
    {
      "include": "#block-ps1"
    },
    {
      "include": "#block-csv"
    },
    {
      "include": "#block-env"
    },
    {
      "include": "#block-dot"
    },
    {
      "include": "#block-yaml"
    },
    {
      "include": "#block-ini"
    },
    {
      "include": "#block-toml"
