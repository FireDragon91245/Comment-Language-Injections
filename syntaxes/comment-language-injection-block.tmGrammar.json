    {
      "include": "#block-ts"
    },
    {
      "include": "#block-tex"
    },
    {
      "include": "#block-makefile"
    }
  ],
  "repository": {
    "block-leading-asterisk": {
      "match": "^\\s*\\*(?![\\/)])(?:\\s)?",
      "name": "punctuation.definition.comment"
    },
    "block-markdown": {
      "begin": "(?:(\\/\\*+|<!--|\\(\\*|--\\[\\[)\\s*)?language=(?:md|markdown)\\b\\s*(?:\\r?\\n)?",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.comment"
        }
      },
      "end": "(?=\\*\\/|-->|\\*\\)|\\]\\])",
      "contentName": "meta.embedded.block.comment-language-injection.markdown",
      "patterns": [
        {
          "include": "#block-leading-asterisk"
        },
        {
          "include": "text.html.markdown"
        }
      ]
    },
    "block-json": {
      "begin": "(?:(\\/\\*+|<!--|\\(\\*|--\\[\\[)\\s*)?language=(?:json)\\b\\s*(?:\\r?\\n)?",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.comment"
        }
      },
      "end": "(?=\\*\\/|-->|\\*\\)|\\]\\])",
      "contentName": "meta.embedded.block.comment-language-injection.json",
      "patterns": [
        {
          "include": "#block-leading-asterisk"
        },
        {
          "include": "source.json"
        }
      ]
    },
